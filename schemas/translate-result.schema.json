{
  "$defs": {
    "TranslatedLine": {
      "properties": {
        "idx": {
          "minimum": 0,
          "title": "Idx",
          "type": "integer"
        },
        "text": {
          "maxLength": 20000,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "idx",
        "text"
      ],
      "title": "TranslatedLine",
      "type": "object"
    }
  },
  "properties": {
    "language": {
      "default": "hu",
      "maxLength": 20,
      "title": "Language",
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "model_used": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Used"
    },
    "prompt_version": {
      "default": 0,
      "title": "Prompt Version",
      "type": "integer"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/TranslatedLine"
      },
      "maxItems": 200000,
      "minItems": 1,
      "title": "Segments",
      "type": "array"
    },
    "missing": {
      "default": 0,
      "title": "Missing",
      "type": "integer"
    },
    "prompt_tokens": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Tokens"
    },
    "completion_tokens": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completion Tokens"
    },
    "reasoning_tokens": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reasoning Tokens"
    },
    "duration_s": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration S"
    }
  },
  "required": [
    "segments"
  ],
  "title": "TranslateResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kzkz22/dwyt-docs/blob/main/schemas/translate-result.schema.json"
}
