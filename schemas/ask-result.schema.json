{
  "description": "The answer to a question (kind ask): Markdown in Hungarian.",
  "properties": {
    "text": {
      "maxLength": 100000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "model_used": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Used"
    },
    "prompt_version": {
      "default": 0,
      "title": "Prompt Version",
      "type": "integer"
    },
    "prompt_tokens": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Tokens"
    },
    "completion_tokens": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completion Tokens"
    },
    "reasoning_tokens": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reasoning Tokens"
    },
    "duration_s": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration S"
    }
  },
  "required": [
    "text"
  ],
  "title": "AskResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kzkz22/dwyt-docs/blob/main/schemas/ask-result.schema.json"
}
